# ==============================================
# CORS CONFIGURATION
# ==============================================
# URLs permitidas para hacer peticiones al backend
# En desarrollo: localhost del frontend
# En producción: URL de Vercel (la obtendrás después del primer deploy)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://tu-frontend.vercel.app

# ==============================================
# FRONTEND URL
# ==============================================
# URL del frontend para redirección en emails de recuperación de contraseña
# En desarrollo: localhost del frontend
# En producción: URL de tu frontend desplegado
